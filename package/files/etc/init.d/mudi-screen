#!/bin/sh /etc/rc.common
# MudiScreen, the open user interface of the touchscreen, in place of
# GL.iNet's gl_screen. Switch between the two with: mudi-screen-mode custom|stock

START=81
STOP=10
USE_PROCD=1

start_service() {
	# A firmware update brings the start link of gl_screen back; while this
	# screen is the chosen one, gl_screen must not start at boot.
	if /etc/init.d/mudi-screen enabled && /etc/init.d/gl_screen enabled; then
		/etc/init.d/gl_screen disable
	fi
	procd_open_instance
	procd_set_param command /usr/libexec/mudi-screen/run
	procd_set_param nice -5
	# Go panics go to the system log; the screen logs to /tmp/mudi-screen.log.
	procd_set_param stderr 1
	procd_close_instance
}
