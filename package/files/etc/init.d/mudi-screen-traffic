#!/bin/sh /etc/rc.common
# The traffic analyzer's collector: statistics of the internet connection,
# the devices, services and connections, for the screen's traffic app. It
# runs whether the screen shows it or not, so the day's numbers are whole.
# Off: uci set mudi-screen.traffic.enabled=0; uci commit; this script restart

START=82
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get mudi-screen.traffic.enabled)" = 0 ] && return 0
	procd_open_instance
	procd_set_param command /usr/bin/mudi-screen app traffic serve
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
