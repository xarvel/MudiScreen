#!/bin/sh
# Supervisor of the screen service. Runs mudi-screen and starts it again when
# it exits, keeps GL's gl_screen off the display while this screen is the
# chosen one, and gives the display to gl_screen after three quick crashes in
# a row, so that a broken build never leaves the screen dark. The service
# stops it with SIGTERM.

BIN=/usr/bin/mudi-screen
child=""

stop_child() {
	[ -n "$child" ] && kill -TERM "$child" 2>/dev/null && wait "$child" 2>/dev/null
	child=""
}
trap 'stop_child; exit 0' TERM INT

stock_off() {
	pidof gl_screen >/dev/null 2>&1 || return 0
	/etc/init.d/gl_screen stop >/dev/null 2>&1
	i=0
	# gl_screen ignores SIGTERM; procd kills it after 5 s.
	while pidof gl_screen >/dev/null 2>&1 && [ $i -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done
	pids=$(pidof gl_screen) && kill -9 $pids 2>/dev/null
	return 0
}

fails=0
grabs=0
grab_since=0
while :; do
	stock_off
	started=$(date +%s)
	"$BIN" "$@" &
	child=$!
	wait "$child"
	rc=$?
	child=""
	now=$(date +%s)
	case $rc in
	0)
		# Stopped by someone else than this supervisor: run again.
		sleep 1
		continue
		;;
	10)
		# gl_screen was started. Take the display back, but not forever:
		# a gl_screen that keeps coming back is wanted by someone.
		if [ $((now - grab_since)) -gt 600 ]; then
			grab_since=$now
			grabs=0
		fi
		grabs=$((grabs + 1))
		if [ $grabs -gt 3 ]; then
			logger -t mudi-screen "gl_screen keeps coming back: leaving the display to it"
			exit 1
		fi
		logger -t mudi-screen "gl_screen was started: taking the display back"
		continue
		;;
	esac
	[ $((now - started)) -ge 60 ] && fails=0
	fails=$((fails + 1))
	logger -t mudi-screen "mudi-screen exited with $rc (crash $fails of 3)"
	if [ $fails -ge 3 ]; then
		logger -t mudi-screen "too many crashes: the stock screen takes over until the next start"
		/etc/init.d/gl_screen start >/dev/null 2>&1
		exit 1
	fi
	sleep 2
done
